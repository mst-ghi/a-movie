APP_KEY=change-me

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=4000

# Upstream movie database (no longer hardcoded in the source)
MOVIE_API_URL=https://example.com
MOVIE_API_KEY=change-me
